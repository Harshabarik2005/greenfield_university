PORT=4000
JWT_SECRET=replace_this_with_a_long_secret
TOKEN_EXPIRES_IN=7d
NOTIFY_FROM=email@instant-library.test
AWS_REGION=ap-south-1

# ─── Email OTP (2-step login + signup verification) ───────────
# console = print codes in the server log (local dev), ses = Amazon SES, smtp = e.g. Gmail
EMAIL_PROVIDER=console
OTP_EXPIRES_MINUTES=10
# true = also return the code to the frontend and show it on screen.
# Use this for demos where accounts (e.g. @greenfield.edu) can't receive real email. Never in real production.
OTP_DEMO_MODE=false

# Amazon SES (EMAIL_PROVIDER=ses): NOTIFY_FROM must be a verified SES identity.
# In the SES sandbox you can only send to verified recipient addresses.
SES_REGION=ap-south-1

# SMTP (EMAIL_PROVIDER=smtp), e.g. Gmail with an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
